
import java.util.*;

public class Lab7 {

    // Problem 1: Sorted Output
    public static void sortedOutput(int[] arr) {
        PriorityQueue<Integer> minHeap = new PriorityQueue<>();

        for (int num : arr) {
            minHeap.add(num);
        }

        System.out.print("Sorted output: ");

        while (!minHeap.isEmpty()) {
            System.out.print(minHeap.poll() + " ");
        }

        System.out.println();
    }

    // Problem 2: Find Maximum
    public static int findMaximum(int[] arr) {
        PriorityQueue<Integer> maxHeap =
            new PriorityQueue<>(Collections.reverseOrder());

        for (int num : arr) {
            maxHeap.add(num);
        }

        if (maxHeap.isEmpty()) {
            throw new IllegalArgumentException("Array cannot be empty");
        }

        return maxHeap.peek();
    }

    // Problem 3: K Smallest Elements
    public static List<Integer> kSmallest(int[] arr, int k) {
        if (k < 0 || k > arr.length) {
            throw new IllegalArgumentException("Invalid k");
        }

        PriorityQueue<Integer> minHeap = new PriorityQueue<>();

        for (int num : arr) {
            minHeap.add(num);
        }

        List<Integer> result = new ArrayList<>();

        for (int i = 0; i < k; i++) {
            result.add(minHeap.poll());
        }

        return result;
    }

    // Problem 4: K Largest Elements
    public static List<Integer> kLargest(int[] arr, int k) {
        if (k < 0 || k > arr.length) {
            throw new IllegalArgumentException("Invalid k");
        }

        PriorityQueue<Integer> minHeap = new PriorityQueue<>();

        for (int num : arr) {
            minHeap.add(num);

            if (minHeap.size() > k) {
                minHeap.poll();
            }
        }

        List<Integer> result = new ArrayList<>();

        while (!minHeap.isEmpty()) {
            result.add(minHeap.poll());
        }

        Collections.reverse(result);

        return result;
    }

    public static void main(String[] args) {

        int[] arr = {4, 2, 7, 1};

        // Problem 1
        sortedOutput(arr);

        // Problem 2
        System.out.println("Maximum: " + findMaximum(arr));

        // Problem 3
        System.out.println("2 Smallest: " +
            kSmallest(arr, 2));

        // Problem 4
        System.out.println("2 Largest: " +
            kLargest(arr, 2));
    }
}
